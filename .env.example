# ─────────────────────────────────────────────────────────────────────────────
# Telegram credentials
# Get API_ID and API_HASH from https://my.telegram.org/apps
# Get BOT_TOKEN from @BotFather on Telegram
# ─────────────────────────────────────────────────────────────────────────────
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare R2
#
# R2_ACCOUNT_ID   – find in Cloudflare dashboard → R2 → Overview
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY – create under R2 → Manage R2 API tokens
# R2_BUCKET_NAME  – the bucket you created
# R2_PUBLIC_URL   – either:
#   • the r2.dev public URL:  https://pub-XXXXX.r2.dev
#   • a custom domain you configured in Cloudflare
# ─────────────────────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=telegram-files
R2_PUBLIC_URL=https://pub-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.dev

# ─────────────────────────────────────────────────────────────────────────────
# Upload tuning (all optional – defaults shown)
# ─────────────────────────────────────────────────────────────────────────────

# Bytes read from Telegram per iteration (default 512 KB)
CHUNK_SIZE=524288

# Files larger than this use multipart upload (default 50 MB)
MULTIPART_THRESHOLD=52428800

# Size of each multipart part (default 50 MB, minimum 5 MB enforced by R2)
MULTIPART_CHUNKSIZE=52428800

# Number of retry attempts on transient errors (default 3)
MAX_RETRIES=3

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
DB_PATH=filebot.db
